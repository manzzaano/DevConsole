    "about_title": "<i data-lucide=\"user-circle\" class=\"w-6 h-6 mr-2\"></i>About Me",
    "about_html": "<div class=\"flex flex-col gap-8\">\n  <div class=\"flex flex-col md:flex-row items-center gap-10\">\n    <div class=\"relative flex-shrink-0\">\n      \n      <div class=\"rounded-full profile-container\" style=\"background-image: url('./foto-perfil.png');\">\n      </div>\n    </div>\n    <div class=\"flex-grow space-y-4 font-mono\">\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2 text-sm\">\n        <p><span class=\"text-emerald-400 font-bold uppercase tracking-tight\">> USER:</span> Ismael Manzano</p>\n        <p><span class=\"text-emerald-400 font-bold uppercase tracking-tight\">> LEVEL:</span> Junior Developer</p>\n        <p><span class=\"text-emerald-400 font-bold uppercase tracking-tight\">> LOCATION:</span> Ciudad Real, ES</p>\n        <p><span class=\"text-emerald-400 font-bold uppercase tracking-tight\">> CORE:</span> Multiplatform Dev</p>\n        <p><span class=\"text-emerald-400 font-bold uppercase tracking-tight\">> STATUS:</span> Open for Hire</p>\n        <p><span class=\"text-emerald-400 font-bold uppercase tracking-tight\">> AGE:</span> 20_years</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"space-y-4 pt-6 border-t border-white/5\">\n    <p class=\"text-xs text-emerald-500/60 font-mono italic\">// Identity_Logs_v1.0.4</p>\n    <div class=\"text-gray-300 space-y-4 leading-relaxed\">\n      <p>I've always been driven by the curiosity of understanding <span class=\"text-emerald-400\">what happens behind the screen</span>. This passion led me to specialize in Multiplatform Application Development (DAM).</p>\n      <p>My background as a kitchen assistant has forged a disciplined work ethic, teaching me <span class=\"text-yellow-400 font-bold\">time management and consistency</span> under extreme pressure.</p>\n      <p>I enjoy solving complex problems, building practical tools, and constantly upgrading my tech stack to add value to innovative professional projects.</p>\n    </div>\n  </div>\n</div>",
    "education_title": "<i data-lucide=\"graduation-cap\" class=\"w-6 h-6 mr-2\"></i>Education",
    "education_html": "<div class=\"space-y-10\">\n  <p class=\"text-gray-400 italic mb-6 text-sm\">// Accessing academic records...</p>\n  <div class=\"relative border-l-2 border-emerald-500/20 ml-3 pl-8 space-y-12\">\n    <div class=\"relative\">\n       <div class=\"absolute -left-[41px] top-0 w-4 h-4 rounded-full bg-emerald-400 shadow-[0_0_10px_#34d399]\"></div>\n       <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2\">\n          <h4 class=\"text-lg font-bold text-emerald-400\">HND in Multiplatform App Development (2nd Year)</h4>\n          <span class=\"tag-badge-yellow\">[ ACTIVE_NODE ]</span>\n       </div>\n       <p class=\"text-gray-400 text-xs mb-3\">IES Maestre de Calatrava | 2025 - 2026</p>\n       <div class=\"flex flex-wrap gap-2\">\n         <span class=\"tag-badge\">Mobile_Dev</span> <span class=\"tag-badge\">BI</span> <span class=\"tag-badge\">Process_Mgmt</span>\n       </div>\n    </div>\n    <div class=\"relative\">\n       <div class=\"absolute -left-[41px] top-0 w-4 h-4 rounded-full bg-gray-600\"></div>\n       <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2\">\n          <h4 class=\"text-lg font-bold text-emerald-400\">HND in Multiplatform App Development (1st Year)</h4>\n          <span class=\"tag-badge\">[ STATUS_OK ]</span>\n       </div>\n       <p class=\"text-gray-400 text-xs mb-3\">IES Gregorio Prieto | 2024 - 2025</p>\n       <div class=\"flex flex-wrap gap-2\">\n         <span class=\"tag-badge\">Java</span> <span class=\"tag-badge\">SQL</span> <span class=\"tag-badge\">UI_Design</span> <span class=\"tag-badge\">Systems</span>\n       </div>\n    </div>\n  </div>\n  <div class=\"pt-6 border-t border-white/5\">\n    <h3 class=\"text-sm font-bold text-yellow-400 mb-6 flex items-center tracking-widest uppercase\">\n      <i data-lucide=\"shield-check\" class=\"w-4 h-4 mr-2\"></i> Verified Licenses\n    </h3>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n       <div class=\"project-card border border-emerald-500/20 bg-emerald-500/5 p-4 rounded-lg flex flex-col group\">\n          <div class=\"flex items-center justify-between mb-2\">\n            <span class=\"text-[10px] text-emerald-400 font-mono\">[ Microsoft_Certified ]</span>\n            <i data-lucide=\"award\" class=\"w-4 h-4 text-emerald-400\"></i>\n          </div>\n          <h5 class=\"text-md font-bold text-white mb-1\">Azure AI Essentials</h5>\n          <p class=\"text-[10px] text-gray-400 mb-4\">Microsoft & LinkedIn | Sept 2025</p>\n          <a href=\"./documents/CertificadoDeFinalizacion_Certificado profesional Microsoft Azure AI Essentials de Microsoft y LinkedIn.pdf\" target=\"_blank\" class=\"tag-badge text-center hover:bg-emerald-400 hover:text-black transition-all\">\n            [ DOWNLOAD_CREDENTIAL ]\n          </a>\n       </div>\n    </div>\n  </div>\n</div>",
    "experience_title": "<i data-lucide=\"briefcase\" class=\"w-6 h-6 mr-2\"></i>Experience",
    "experience_html": "<div class=\"space-y-8\">\n  <p class=\"text-gray-400 italic mb-4 text-sm\">// Initializing workload execution trace...</p>\n  <div class=\"grid grid-cols-1 gap-6\">\n    <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl flex flex-col group\">\n      <div class=\"flex justify-between items-start mb-4\">\n        <div>\n          <span class=\"text-[10px] text-emerald-500 font-mono tracking-widest uppercase\">[ DEPLOYMENT_01 ]</span>\n          <h4 class=\"text-xl font-bold text-emerald-400\">Savia by Berger-Levrault</h4>\n          <p class=\"text-xs text-gray-400\">Developer Intern | March - April 2025</p>\n        </div>\n        <i data-lucide=\"terminal\" class=\"w-5 h-5 text-emerald-500\"></i>\n      </div>\n      <div class=\"space-y-2 font-mono text-xs text-gray-300 mb-4\">\n        <p><span class=\"text-emerald-500\">[ OK ]</span> Frontend architecture with React & Vite</p>\n        <p><span class=\"text-emerald-500\">[ OK ]</span> Cloud implementation on Azure</p>\n        <p><span class=\"text-emerald-500\">[ OK ]</span> Version control via Git/GitHub</p>\n        <p><span class=\"text-emerald-500\">[ DONE ]</span> UI/UX interface optimization</p>\n      </div>\n      <div class=\"flex flex-wrap gap-2 pt-3 border-t border-white/5\">\n        <span class=\"tag-badge\">React</span> <span class=\"tag-badge\">Vite</span> <span class=\"tag-badge\">Azure</span> <span class=\"tag-badge\">JavaScript</span>\n      </div>\n    </div>\n    <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl flex flex-col group\">\n      <div class=\"flex justify-between items-start mb-4\">\n        <div>\n          <span class=\"text-[10px] text-yellow-500 font-mono tracking-widest uppercase\">[ DEPLOYMENT_02 ]</span>\n          <h4 class=\"text-xl font-bold text-yellow-400\">Cojali S.L.</h4>\n          <p class=\"text-xs text-gray-400\">Tech Intern | February 2025</p>\n        </div>\n        <i data-lucide=\"cpu\" class=\"w-5 h-5 text-yellow-500\"></i>\n      </div>\n      <div class=\"space-y-2 font-mono text-xs text-gray-300 mb-4\">\n        <p><span class=\"text-yellow-500\">[ OK ]</span> Software testing & Bug tracking</p>\n        <p><span class=\"text-yellow-500\">[ OK ]</span> Logics application & Analysis</p>\n        <p><span class=\"text-yellow-500\">[ DONE ]</span> Corporate tools integration</p>\n      </div>\n    </div>\n    <div class=\"project-card border border-cyan-500/20 bg-cyan-500/5 p-5 rounded-xl flex flex-col group\">\n      <div class=\"flex justify-between items-start mb-4\">\n        <div>\n          <span class=\"text-[10px] text-cyan-400 font-mono tracking-widest uppercase\">[ OPERATIONAL_CORE ]</span>\n          <h4 class=\"text-xl font-bold text-cyan-400\">Kitchen Assistant</h4>\n          <p class=\"text-xs text-gray-400 text-cyan-400/60\">High-Intensity Node | Present</p>\n        </div>\n        <i data-lucide=\"zap\" class=\"w-5 h-5 text-cyan-400\"></i>\n      </div>\n      <div class=\"space-y-2 font-mono text-xs text-gray-300 mb-4\">\n        <p><span class=\"text-cyan-400\">[ HIGH ]</span> Pressure tolerance & Stress management</p>\n        <p><span class=\"text-cyan-400\">[ OK ]</span> Resource & Time optimization</p>\n        <p><span class=\"text-cyan-400\">[ DONE ]</span> Team sync & Workflow consistency</p>\n      </div>\n    </div>\n  </div>\n</div>",
    "skills_title": "<i data-lucide=\"swords\" class=\"w-6 h-6 mr-2\"></i>Technical Skills",
    "skills_html": "<div class=\"space-y-6\">\n  <p class=\"text-gray-400 italic mb-4 text-sm\">// Running system capabilities diagnostic...</p>\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n    <div class=\"border border-white/10 bg-white/5 p-4 rounded-lg backdrop-blur-sm hover:border-emerald-400 transition-colors\">\n      <div class=\"flex items-center mb-4 text-emerald-400\">\n        <i data-lucide=\"code-2\" class=\"w-5 h-5 mr-2\"></i>\n        <h4 class=\"font-bold uppercase tracking-widest text-sm\">Programming Languages</h4>\n      </div>\n      <div class=\"flex flex-wrap gap-2\">\n        <span class=\"skill-badge\">Java</span>\n        <span class=\"skill-badge\">C#</span>\n        <span class=\"skill-badge\">JavaScript</span>\n        <span class=\"skill-badge\">PHP</span>\n        <span class=\"skill-badge\">Python</span>\n        <span class=\"skill-badge\">SQL</span>\n        <span class=\"skill-badge\">HTML/CSS</span>\n      </div>\n    </div>\n    <div class=\"border border-white/10 bg-white/5 p-4 rounded-lg backdrop-blur-sm hover:border-yellow-400 transition-colors\">\n      <div class=\"flex items-center mb-4 text-yellow-400\">\n        <i data-lucide=\"layers\" class=\"w-5 h-5 mr-2\"></i>\n        <h4 class=\"font-bold uppercase tracking-widest text-sm\">Frontend & Frameworks</h4>\n      </div>\n      <div class=\"flex flex-wrap gap-2\">\n        <span class=\"skill-badge-yellow\">Laravel</span>\n        <span class=\"skill-badge-yellow\">Vue.js</span>\n        <span class=\"skill-badge-yellow\">React</span>\n        <span class=\"skill-badge-yellow\">Tailwind CSS</span>\n        <span class=\"skill-badge-yellow\">Bootstrap</span>\n        <span class=\"skill-badge-yellow\">Vite</span>\n      </div>\n    </div>\n    <div class=\"border border-white/10 bg-white/5 p-4 rounded-lg backdrop-blur-sm hover:border-cyan-400 transition-colors\">\n      <div class=\"flex items-center mb-4 text-cyan-400\">\n        <i data-lucide=\"box\" class=\"w-5 h-5 mr-2\"></i>\n        <h4 class=\"font-bold uppercase tracking-widest text-sm\">Infrastructure & Tools</h4>\n      </div>\n      <div class=\"flex flex-wrap gap-2\">\n        <span class=\"skill-badge-cyan\">Docker</span>\n        <span class=\"skill-badge-cyan\">Git/GitHub</span>\n        <span class=\"skill-badge-cyan\">Azure</span>\n        <span class=\"skill-badge-cyan\">VirtualBox</span>\n        <span class=\"skill-badge-cyan\">MySQL / SQL Server</span>\n      </div>\n    </div>\n    <div class=\"border border-white/10 bg-white/5 p-4 rounded-lg backdrop-blur-sm hover:border-purple-400 transition-colors\">\n      <div class=\"flex items-center mb-4 text-purple-400\">\n        <i data-lucide=\"cpu\" class=\"w-5 h-5 mr-2\"></i>\n        <h4 class=\"font-bold uppercase tracking-widest text-sm\">Architecture & Others</h4>\n      </div>\n      <div class=\"flex flex-wrap gap-2\">\n        <span class=\"skill-badge-purple\">OOP</span>\n        <span class=\"skill-badge-purple\">MVC / MVVM</span>\n        <span class=\"skill-badge-purple\">Scrum / Kanban</span>\n        <span class=\"skill-badge-purple\">Jira / Trello</span>\n      </div>\n    </div>\n  </div>\n</div>",
    "projects_title": "<i data-lucide=\"folder-git-2\" class=\"w-6 h-6 mr-2\"></i>Projects",
    "projects_html": "<div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n  <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl backdrop-blur-md hover:border-emerald-400 transition-all flex flex-col group\">\n    <div class=\"flex justify-between items-start mb-3\">\n      <div>\n        <span class=\"text-[10px] text-emerald-500 font-mono tracking-widest uppercase\">[ Project_01 ]</span>\n        <h4 class=\"text-xl font-bold text-emerald-400 group-hover:glow transition-all\">Regicide</h4>\n      </div>\n      <div class=\"flex gap-3\">\n        <a href=\"https://github.com/manzzaano/REGICIDE\" target=\"_blank\" class=\"text-gray-400 hover:text-white transition-colors\">\n          <i data-lucide=\"github\" class=\"w-5 h-5\"></i>\n        </a>\n      </div>\n    </div>\n    <p class=\"text-sm text-gray-300 mb-4 flex-grow leading-relaxed\">\n      Card game developed in <span class=\"text-emerald-400\">Java with JavaFX</span>. Includes JSON data persistence and CSV statistics. Deep focus on game logic and design patterns.\n    </p>\n    <div class=\"flex flex-wrap gap-2 mt-auto pt-4 border-t border-white/5\">\n      <span class=\"tag-badge\">Java</span>\n      <span class=\"tag-badge\">JavaFX</span>\n      <span class=\"tag-badge\">JSON</span>\n    </div>\n  </div>\n  <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl backdrop-blur-md hover:border-yellow-400 transition-all flex flex-col group\">\n    <div class=\"flex justify-between items-start mb-3\">\n      <div>\n        <span class=\"text-[10px] text-yellow-500 font-mono tracking-widest uppercase\">[ Project_02 ]</span>\n        <h4 class=\"text-xl font-bold text-yellow-400 group-hover:glow-yellow transition-all\">Pokédex</h4>\n      </div>\n      <div class=\"flex gap-3\">\n        <a href=\"https://github.com/manzzaano/POKEDEX\" target=\"_blank\" class=\"text-gray-400 hover:text-white transition-colors\">\n          <i data-lucide=\"github\" class=\"w-5 h-5\"></i>\n        </a>\n      </div>\n    </div>\n    <p class=\"text-sm text-gray-300 mb-4 flex-grow leading-relaxed\">\n      Dynamic Pokémon explorer built with <span class=\"text-yellow-400\">React and Vite</span>. Consumes PokéAPI with asynchronous rendering and smooth navigation.\n    </p>\n    <div class=\"flex flex-wrap gap-2 mt-auto pt-4 border-t border-white/5\">\n      <span class=\"tag-badge-yellow\">React</span>\n      <span class=\"tag-badge-yellow\">Vite</span>\n      <span class=\"tag-badge-yellow\">API</span>\n    </div>\n  </div>\n  <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl backdrop-blur-md hover:border-cyan-400 transition-all flex flex-col group\">\n    <div class=\"flex justify-between items-start mb-3\">\n      <div>\n        <span class=\"text-[10px] text-cyan-500 font-mono tracking-widest uppercase\">[ Project_03 ]</span>\n        <h4 class=\"text-xl font-bold text-cyan-400 group-hover:glow-cyan transition-all\">Terminal Portfolio</h4>\n      </div>\n      <div class=\"flex gap-3\">\n        <a href=\"https://github.com/manzzaano/PortafolioTerminal\" target=\"_blank\" class=\"text-gray-400 hover:text-white transition-colors\">\n          <i data-lucide=\"github\" class=\"w-5 h-5\"></i>\n        </a>\n      </div>\n    </div>\n    <p class=\"text-sm text-gray-300 mb-4 flex-grow leading-relaxed\">\n      This very portfolio. Interactive retro-futuristic interface with <span class=\"text-cyan-400\">Vue 3 and WebGL</span>. Real command system and bilingüe support.\n    </p>\n    <div class=\"flex flex-wrap gap-2 mt-auto pt-4 border-t border-white/5\">\n      <span class=\"tag-badge-cyan\">Vue 3</span>\n      <span class=\"tag-badge-cyan\">Tailwind</span>\n      <span class=\"tag-badge-cyan\">WebGL</span>\n    </div>\n  </div>\n</div>",
    "contact_title": "<i data-lucide=\"message-square-more\" class=\"w-6 h-6 mr-2\"></i>Contact",
    "contact_html": "<div class=\"space-y-8\">\n  <p class=\"text-gray-400 italic mb-4 text-sm text-center\">// Establishing secure communication uplink...</p>\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n    <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl flex flex-col items-center text-center group hover:border-emerald-400 transition-all\">\n      <i data-lucide=\"mail\" class=\"w-8 h-8 text-emerald-400 mb-3 group-hover:scale-110 transition-transform\"></i>\n      <h4 class=\"font-bold text-white mb-1\">Email</h4>\n      <p class=\"text-[10px] text-gray-500 font-mono uppercase mb-4\">Protocol: SMTP</p>\n      <span class=\"text-[10px] text-emerald-500 font-mono mb-4\">[ ONLINE ]</span>\n      <a href=\"https://mail.google.com/mail/?view=cm&fs=1&to=ismaelmanzanoleon@gmail.com\" target=\"_blank\" class=\"tag-badge w-full text-center hover:bg-emerald-400 hover:text-black transition-all font-bold\">\n        [ CONNECT ]\n      </a>\n    </div>\n    <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl flex flex-col items-center text-center group hover:border-cyan-400 transition-all\">\n      <i data-lucide=\"linkedin\" class=\"w-8 h-8 text-cyan-400 mb-3 group-hover:scale-110 transition-transform\"></i>\n      <h4 class=\"font-bold text-white mb-1\">LinkedIn</h4>\n      <p class=\"text-[10px] text-gray-500 font-mono uppercase mb-4\">Protocol: HTTPS</p>\n      <span class=\"text-[10px] text-emerald-500 font-mono mb-4\">[ READY ]</span>\n      <a href=\"https://www.linkedin.com/in/ismael-manzano-león-84b266238/\" target=\"_blank\" class=\"tag-badge-cyan w-full text-center hover:bg-cyan-400 hover:text-black transition-all font-bold\">\n        [ SYNC ]\n      </a>\n    </div>\n    <div class=\"project-card border border-white/10 bg-white/5 p-5 rounded-xl flex flex-col items-center text-center group hover:border-yellow-400 transition-all\">\n      <i data-lucide=\"github\" class=\"w-8 h-8 text-yellow-400 mb-3 group-hover:scale-110 transition-transform\"></i>\n      <h4 class=\"font-bold text-white mb-1\">GitHub</h4>\n      <p class=\"text-[10px] text-gray-500 font-mono uppercase mb-4\">Protocol: SSH</p>\n      <span class=\"text-[10px] text-emerald-500 font-mono mb-4\">[ ACTIVE ]</span>\n      <a href=\"https://github.com/manzzaano\" target=\"_blank\" class=\"tag-badge-yellow w-full text-center hover:bg-yellow-400 hover:text-black transition-all font-bold\">\n        [ EXPLORE ]\n      </a>\n    </div>\n  </div>\n</div>",
    "cv_title": "<i data-lucide=\"file-text\" class=\"w-6 h-6 mr-2\"></i>Download CV",
    "cv_html": "\n      <div class=\"text-center\">\n        <p class=\"text-lg mb-4\">Click the link to download the full version of my resume in PDF format.</p>\n        <a href=\"./documents/Ismael_Manzano_CV.pdf\" target=\"_blank\" class=\"inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 px-6 rounded-lg transition-colors\">\n          <i data-lucide=\"file-down\" class=\"w-5 h-5\"></i>\n          <span>Download Ismael_Manzano_CV.pdf</span>\n        </a>\n      </div>"
